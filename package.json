{
  "name": "PNUTDownloader",
  "version": "1.0.46",
  "description": "Your favorite video downloader",
  "main": "./out/main/index.js",
  "author": "PNUT Downloader",
  "homepage": "https://github.com/Shoaib-Akh/pnutdownloader",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "rimraf dist out && npm run build && electron-builder --win && electron-builder --publish=always",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "publish:release": "electron-builder --publish=always"
  },
  "dependencies": {
    "@aptabase/electron": "^0.3.1",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "bootstrap": "^5.3.3",
    "electron-dl": "^4.0.0",
    "electron-updater": "^6.3.9",
    "firebase": "^12.8.0",
    "install": "^0.13.0",
    "npm": "^11.1.0",
    "react-bootstrap": "^2.10.9",
    "react-icons": "^5.5.0",
    "react-loading-skeleton": "^3.5.0",
    "tar": "^7.4.3",
    "tree-kill": "^1.2.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.0.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-packager": "^17.1.2",
    "electron-vite": "^3.0.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "prettier": "^3.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.shoaibakh.pnutdownloader",
    "asar": true,
    "files": [
      "out/**/*",
      "dist/**/*",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/node_modules/**/*.md",
      "!**/node_modules/**/*.txt",
      "!**/node_modules/**/test",
      "!**/node_modules/**/tests",
      "!**/node_modules/**/*.test.js",
      "!**/node_modules/**/*.spec.js",
      "!**/node_modules/**/examples",
      "!**/node_modules/**/example",
      "!**/.vscode",
      "!**/.idea",
      "!**/src",
      "!**/electron.vite.config.*.mjs"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": "nsis",
      "compression": "maximum"
    },
    "linux": {
      "icon": "resources/icon.png"
    },
    "mac": {
      "icon": "resources/icon.icns"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Shoaib-Akh/pnutdownloader.git"
  },
  "publish": {
    "provider": "github",
    "owner": "Shoaib-Akh",
    "repo": "pnutdownloader",
    "releaseType": "release"
  }
}
